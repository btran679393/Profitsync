  {
    "id": "table.order",
    "label": "Create table \"order\"",
    "summary": "Creates table \"order\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "order"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"order\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"public\".\"order\""
        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"order\"",
        "sql": "CREATE TABLE \"public\".\"order\" (\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"ebayFees\" numeric NOT NULL,\n  \"ebayOrderId\" text,\n  \"id\" SERIAL NOT NULL,\n  \"item\" text NOT NULL,\n  \"orderDate\" timestamptz DEFAULT (now()) NOT NULL,\n  \"productCost\" numeric,\n  \"salePrice\" numeric NOT NULL,\n  \"status\" text DEFAULT 'COST_NEEDED' NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"order\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"order\""
        ]
      }
    ]
  },
  {
    "id": "unique.order.order_ebayOrderId_key",
    "label": "Add unique constraint on \"order\" (ebayOrderId)",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "unique",
        "name": "order_ebayOrderId_key",
        "table": "order"
      }
    },
    "precheck": [
      {
        "description": "ensure constraint \"order_ebayOrderId_key\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "order_ebayOrderId_key",
          "public",
          "\"public\".\"order\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add unique constraint \"order_ebayOrderId_key\"",
        "sql": "ALTER TABLE \"public\".\"order\" ADD CONSTRAINT \"order_ebayOrderId_key\" UNIQUE (\"ebayOrderId\")"
      }
    ],
    "postcheck": [
      {
        "description": "verify constraint \"order_ebayOrderId_key\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "order_ebayOrderId_key",
          "public",
          "\"public\".\"order\""
        ]
      }
    ]
