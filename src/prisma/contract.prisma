// use prisma-next

model Order {
  id           Int      @id @default(autoincrement())

  // Supabase user who owns this order
  userId       String?

  ebayOrderId  String?  @unique
  ebayUserId   String?
  ebayBuyerId  String?
  environment  String   @default("SANDBOX")

  // Order information
  item         String

  // eBay listing identification
  // Used to match sold jerseys to active listings
  ebayItemId      String?
  ebayVariationId String?
  sku             String?

  // Number of units sold
  quantity        Int      @default(1)

  // Financial information
  salePrice    Decimal
  ebayFees     Decimal
  productCost  Decimal?

  // Net shipping label spend through eBay (labels bought minus voided).
  // Added by docs/sql/2026-11-07_shipping_label_cost.sql
  shippingLabelCost Decimal?

  // Shipping the seller paid outside eBay (typed in). Overrides the eBay
  // label cost in profit. Added by docs/sql/2026-11-07_shipping_cost.sql
  shippingCost      Decimal?

  // Actual eBay listing image URL
  imageUrl     String?

  // Order status:
  // COST_NEEDED
  // COMPLETED
  // REFUNDED
  // PARTIALLY_REFUNDED
  status       String   @default("COST_NEEDED")

  // Refund information
  // Amount refunded to the buyer in USD
  refundAmount Decimal?

  // Date the refund was processed
  refundedAt   TimestamptzString?

  // Timestamps
  orderDate    TimestamptzString @default(now())
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model EbayConnection {
  id                    Int        @id @default(autoincrement())

  // Supabase user who owns this connection
  userId                String?

  ebayUserId            String?
  environment           String     @default("SANDBOX")

  accessToken           String
  refreshToken          String

  accessTokenExpiresAt  TimestamptzString
  refreshTokenExpiresAt TimestamptzString

  // Shown in the dashboard greeting; refreshed on every listing sync.
  // Added by docs/sql/2026-11-07_ebay_store_name.sql
  ebayUsername          String?
  storeName             String?

  createdAt             TimestamptzString @default(now())
  updatedAt             temporal.updatedAtString()
}

// ============================================================
// EBAY ACTIVE LISTINGS
// ============================================================

model EbayListing {
  id            Int      @id @default(autoincrement())

  // Supabase user who owns this listing
  userId        String

  // Connected eBay account
  ebayUserId    String
  environment   String   @default("PRODUCTION")

  // eBay listing identification
  ebayItemId    String
  title         String
  sku           String?

  // Listing information
  imageUrl      String?
  listingPrice  Decimal

  // Available quantity
  quantity      Int      @default(0)

  // What one unit costs the seller. New sales from this listing get
  // productCost = unitCost × quantity automatically.
  unitCost      Decimal?

  // Default shipping per order for new sales from this listing.
  // Added by docs/sql/2026-11-07_shipping_cost.sql
  shippingCost  Decimal?

  // Listing status:
  // ACTIVE
  // ENDED
  // SOLD_OUT
  status        String   @default("ACTIVE")

  // Timestamps
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  // Prevent duplicate listings for the same account
  @@unique([userId, ebayUserId, environment, ebayItemId])
}