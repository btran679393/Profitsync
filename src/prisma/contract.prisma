
// use prisma-next

model Order {
  id           Int      @id @default(autoincrement())

  // Supabase user who owns this order
  userId       String?

  ebayOrderId  String?  @unique
  ebayUserId   String?
  ebayBuyerId  String?
  environment  String   @default("SANDBOX")

  item         String

  salePrice    Decimal
  ebayFees     Decimal
  productCost  Decimal?

  status       String   @default("COST_NEEDED")

  orderDate    TimestamptzString @default(now())
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model EbayConnection {
  id                    Int        @id @default(autoincrement())

  // Supabase user who owns this connection
  userId                String?

  ebayUserId            String?
  environment           String     @default("SANDBOX")

  accessToken           String
  refreshToken          String

  accessTokenExpiresAt  TimestamptzString
  refreshTokenExpiresAt TimestamptzString

  createdAt             TimestamptzString @default(now())
  updatedAt             temporal.updatedAtString()
}
